APP_NAME=Vwajèn
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ht
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=America/Port-au-Prince

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vwajen
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_COOKIE=vwajen_session
SESSION_LIFETIME=240
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@vwajen.ht"
MAIL_FROM_NAME="${APP_NAME}"

# Connexion Google (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Connexion Apple (https://developer.apple.com)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI="${APP_URL}/auth/apple/callback"

# SMS (vérification téléphone / notifications SMS) : log | twilio
SMS_DRIVER=log
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Web Push (générer avec: php artisan vwajen:vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:admin@vwajen.ht"

# Vidéo : chemin vers ffmpeg / ffprobe (compression, qualités multiples, miniatures)
FFMPEG_PATH=
FFPROBE_PATH=

# Live : serveurs STUN/TURN pour WebRTC (séparés par des virgules)
WEBRTC_STUN=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# IA (résumés, traduction, modération assistée, recherche intelligente)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Transcription automatique (endpoint compatible Whisper, optionnel)
TRANSCRIPTION_URL=
TRANSCRIPTION_KEY=
